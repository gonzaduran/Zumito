# Copia este archivo a .env.local y rellena los valores de tu proyecto de Supabase
# (Project Settings > API). Solo van claves públicas: la service role key NUNCA
# se pone aquí ni en ninguna variable NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
# Publishable key (sb_publishable_...). La anon key antigua también funciona.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=tu-publishable-key

# --- Pagos (Stripe) ----------------------------------------------------------
# SOLO en el servidor (Vercel > Settings > Environment Variables). Nunca con NEXT_PUBLIC_.
# Sin estas variables la app funciona igual y la pantalla de planes dice "muy pronto".
# `npm run stripe:setup` crea el producto, los precios, el cupón y el portal y te
# imprime estas líneas. Usa claves de prueba (sk_test_…) hasta salir a producción.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_YEARLY=
STRIPE_COUPON_WELCOME=
STRIPE_PORTAL_CONFIGURATION=
# Clave secreta de Supabase (Project Settings > API Keys > Secret key, sb_secret_…).
# La usan solo el webhook y el pago para guardar la suscripción. Jamás en el cliente.
SUPABASE_SECRET_KEY=
